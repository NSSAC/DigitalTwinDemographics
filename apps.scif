%appinstall dtd
cp /docker_context/environment.yml .
micromamba install --yes --name base --file environment.yml
cd lib
cp /docker_context/src/app_dtd.py .
chmod +x app_dtd.py
cd ../bin
ln -s ../lib/app_dtd.py

%apphelp dtd
Digital Twin demographics is a simple app that uses population digitial twins to count demographic groups 

%apprun app_dtd
CMD="app_dtd.py $@"
echo "Running $CMD" &&
$CMD

%apprun app_dtd_sciduct
mkdir -p $SCIF_APPDATA
US_STATE=$(jq -r .input.us_states /job/job.json)"
POLYGON=$(jq -r .input.polygon /job/job.json)"

POLYGON_DISPLAY=$(jq -r .input.polygon /job/job.json)

# Map human readable polygon name back to the internal key the script expects
if [ "$POLYGON_DISPLAY" == "DMA (Designated Market Area) boundaries" ]; then
    POLYGON="DMA"
elif [ "$POLYGON_DISPLAY" == "HSA boundaries" ]; then
    POLYGON="HSA"
elif [ "$POLYGON_DISPLAY" == "HRR boundaries" ]; then
    POLYGON="HRR"
elif [ "$POLYGON_DISPLAY" == "Wastewater Scan Polygons" ]; then
    POLYGON="wastewater"
else
    POLYGON="DMA"
fi

scif run app_dtd --us_states $US_STATE --polygon $POLYGON --outdir $SCIF_APPDATA
